<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account.action_account_payments" model="ir.actions.act_window">
        <field name="domain">[("payment_type","=","inbound")]</field>
    </record>
    <record id="account.action_account_payments_payable" model="ir.actions.act_window">
        <field name="domain">[("payment_type","=","outbound")]</field>
    </record>
    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
            <field name="arch" type="xml">
                <filter name="inbound_filter" position="attributes">
                    <attribute name="domain">[('partner_type', '=', 'customer'),
                                              ('is_internal_transfer', '=', False),
                                              ('partner_id','!=', False)]</attribute>
                </filter>
                <filter name="outbound_filter" position="attributes">
                    <attribute name="domain">[('partner_type', '=', 'supplier'),
                                              ('is_internal_transfer', '=', False),
                                              ('partner_id','!=', False)]</attribute>
                </filter>
            </field>
    </record>
</odoo>
