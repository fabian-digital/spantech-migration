<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="spantech_base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_spantech_block')]" position="inside">
                <h2>Prepayments</h2>
                <div class="row mt16 o_settings_container" id="spantech_prepayments">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="prepayment_journal_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Default Prepayment Journal
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="prepayment_journal_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="prepayment_payment_mode_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Default Prepayment Mode
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="prepayment_payment_mode_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
