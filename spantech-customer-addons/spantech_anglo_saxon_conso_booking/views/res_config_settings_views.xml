<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="spantech_base.res_config_settings_view_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='spantech_base']" position="inside">
                <h2>Inter-company P&amp;L consolidation Booking</h2>
                <div class="row mt16 o_settings_container" id="spantech_itr_conso">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="itr_account_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Invoice To Receive Account
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="itr_account_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                            <label for="itr_ico_account_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Invoice To Receive ICO Account
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="itr_ico_account_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                            <label for="conso_booking_journal_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Consolidation Entry Journal
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="conso_booking_journal_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="fg_var_account_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Finished Goods Stock Variation Account
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="fg_var_account_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="fg_var_ico_account_id" />
                            <span
                                class="fa fa-lg fa-building-o"
                                title="Values set here are company-specific."
                                role="img"
                                aria-label="Values set here are company-specific."
                                groups="base.group_multi_company"
                            />
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    Finished Goods ICO Stock Variation Account
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field
                                        name="fg_var_ico_account_id"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
