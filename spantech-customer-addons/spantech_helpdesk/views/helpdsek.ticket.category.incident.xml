<?xml version="1.0" ?>
<odoo>
    <!-- HELPDESK.TICKET.TYPE -->
     <record id="helpdesk_ticket_category_ioncident_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.incident.tree</field>
        <field name="model">helpdesk.ticket.category.incident</field>
        <field name="arch" type="xml">
            <tree editable="top" sample="1">
                <field name="sequence" widget="handle" groups="base.group_no_one" />
                <field name="name" />
                <field name="help" />
            </tree>
        </field>
    </record>

    <record id="helpdesk_ticket_category_incident_action" model="ir.actions.act_window">
        <field name="name">Ticket Category of incident</field>
        <field name="res_model">helpdesk.ticket.category.incident</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No types found. Let's create one!
          </p><p>
            Category of incident are perfect to categorize your tickets.
          </p>
        </field>
    </record>

    <menuitem
        id="helpdesk_ticket_category_incident_menu"
        action="helpdesk_ticket_category_incident_action"
        sequence="2"
        parent="helpdesk.helpdesk_menu_config"
    />
</odoo>
