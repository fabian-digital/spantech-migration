<?xml version="1.0" ?>
<odoo>

    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project task tickets Inherited view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_open_helpdesk_ticket_view"
                    icon="fa-life-ring"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="ticket_count" nolabel="1" />
                            <span class="text-secondary fw-normal"> Tickets</span>
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">view_task_tree2</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <button
                    name="action_open_helpdesk_ticket_view"
                    string="Tickets"
                    type="object"
                    class="btn-link"
                    icon="fa-life-ring"
                    attrs="{'invisible': [('ticket_count', '=', 0)]}"
                >
                    <field name="ticket_count" invisible="1" />
                </button>
            </field>
        </field>
    </record>

</odoo>
