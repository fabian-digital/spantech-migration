<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="account_journal_credit_cards_staff" model="account.journal">
        <field name="name">Credit Cards Staff</field>
        <field name="code">CC</field>
        <field name="type">bank</field>
        <field name="sequence">99</field>
        <field name="alias_name">credit_cards_staff</field>
        <field
            name="default_account_id"
            ref="spantech_hr.account_account_credit_cards_staff"
        />
        <field
            name="suspense_account_id"
            ref="spantech_hr.account_account_susp_acc_credit_cards_staff"
        />
        <field name="is_spantech_expense" eval="True" />
        <field name="company_id" ref="base.main_company" />
    </record>
    <record id="account_journal_cash_withdrawal_staff" model="account.journal">
        <field name="name">Cash Withdrawal Staff</field>
        <field name="code">CW</field>
        <field name="type">bank</field>
        <field name="sequence">99</field>
        <field name="alias_name">cash_withdrawal_staff</field>
        <field
            name="default_account_id"
            ref="spantech_hr.account_account_cash_withdrawal_staff"
        />
        <field
            name="suspense_account_id"
            ref="spantech_hr.account_account_susp_acc_cash_withdrawal_staff"
        />
        <field name="is_spantech_expense" eval="True" />
        <field name="company_id" ref="base.main_company" />
    </record>
    <record id="account_journal_prepaid_cards_staff" model="account.journal">
        <field name="name">Prepaid Card Staff</field>
        <field name="code">PC</field>
        <field name="type">bank</field>
        <field name="sequence">99</field>
        <field name="alias_name">prepaid_cards_staff</field>
        <field
            name="default_account_id"
            ref="spantech_hr.account_account_prepaid_cards_staff"
        />
        <field
            name="suspense_account_id"
            ref="spantech_hr.account_account_susp_acc_prepaid_cards_staff"
        />
        <field name="is_spantech_expense" eval="True" />
        <field name="company_id" ref="base.main_company" />
    </record>
    <record id="account_journal_expense_notes" model="account.journal">
        <field name="name">Expense Notes Journal</field>
        <field name="code">EXPSP</field>
        <field name="type">purchase</field>
        <field name="sequence">99</field>
        <field name="alias_name">expense_notes</field>
        <field name="is_spantech_expense" eval="True" />
        <field name="company_id" ref="base.main_company" />
    </record>
</odoo>
