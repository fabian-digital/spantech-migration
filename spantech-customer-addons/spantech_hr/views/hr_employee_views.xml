<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <group name="identification_group" position="after">
                <group
                    string="Expenses"
                    name="spantech_expenses"
                    groups="hr_expense.group_hr_expense_manager"
                >
                    <field name="allowed_expense_journal_domain" invisible="1" />
                    <field
                        name="allowed_expense_journal_ids"
                        domain="allowed_expense_journal_domain"
                        widget="many2many_checkboxes"
                    />
                    <field name="allow_create_expense_report" />
                    <field name="allow_submit_expense_report" />
                </group>
            </group>
        </field>
    </record>

    <record id="hr_employee_view_form_inherit_expense" model="ir.ui.view">
        <field name="name">hr.employee.form.expense.reviewer</field>
        <field name="model">hr.employee</field>
        <field
            name="inherit_id"
            ref="hr_expense.hr_employee_view_form_inherit_expense"
        />
        <field name="arch" type="xml">
            <field name="expense_manager_id" position="after">
                <field name="expense_reviewer_id" />
            </field>
        </field>
    </record>

</odoo>
