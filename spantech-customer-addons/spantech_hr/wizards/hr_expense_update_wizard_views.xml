<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_update_wizard_view_form" model="ir.ui.view">
        <field name="name">Update Expense</field>
        <field name="model">hr.expense.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Expense">
                <group>
                    <field name="product_id" />
                    <field name="account_id" />
                    <field name="tax_ids" widget="many2many_tags" />
                    <field
                        name="analytic_distribution"
                        widget="analytic_distribution"
                        options="{'product_field': 'product_id', 'business_domain': 'expense'}"
                    />
                    <field name="company_id" invisible="1" />
                </group>
                <footer>
            <button name="update" string="Confirm" type="object" class="oe_highlight" />
            <button string="Cancel" class="oe_link" special="cancel" />
          </footer>
            </form>
        </field>
    </record>
</odoo>
