<odoo noupdate="1">

    <record id="ir_cron_project_performance" model="ir.cron">
        <field name="name">Project Performance Save</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field
            name="nextcall"
            eval="(DateTime.now().replace(hour=2, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="doall" eval="False" />
        <field name="model_id" ref="model_project_project" />
        <field name="code">
stages = env["project.project.stage"].search([("name", "=", "In Progress")])
projects = model.with_context(active_test=False).search([("stage_id", "in", stages.ids)])
projects.save_project_performance()
        </field>
        <field name="state">code</field>
    </record>

</odoo>
