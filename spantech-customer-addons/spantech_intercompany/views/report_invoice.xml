<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        priority="100"
    >
        <table name="invoice_line_table" position="before">
            <div
                class="mb-2"
                t-if="o.invoice_origin and o.env['sale.order'].search([('name', '=', o.invoice_origin)], limit=1) and o.env['sale.order'].search([('name', '=', o.invoice_origin)], limit=1).intercompany_buyer"
            >
                <strong>ICO Buyer: </strong>
                <span
                    t-esc="o.env['sale.order'].search([('name', '=', o.invoice_origin)], limit=1).intercompany_buyer"
                />
            </div>
        </table>
    </template>
</odoo>
