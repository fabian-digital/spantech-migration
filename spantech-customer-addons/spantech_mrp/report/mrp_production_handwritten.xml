<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template
        name="Production Order Handwritten"
        id="mrp_production_handwritten_report_document"
    >
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    table, th, td {
                      border: 1px solid black;
                      border-collapse: collapse;
                    }
                </style>

                <div id="page1_div" style="page-break-after: always;">
                    <table width="100%">
                        <thead>
                            <td width="50%;">
                                <div style="width: 100%; text-align: center">
                                    <span t-field="o.name" />
                                </div>
                                <div style="width: 100%; margin-bottom: 10px">
                                    <div style="width: 100%">
                                        <span>Data utworzenia MO: </span><span
                                            t-field="o.create_date"
                                            t-options="{'widget': 'date'}"
                                        />
                                    </div>
                                    <div style="width: 100%">
                                        <span>Planowana data produkcji: </span><span
                                            t-field="o.date_planned_start"
                                            t-options="{'widget': 'date'}"
                                        />
                                    </div>
                                    <div style="width: 100%">
                                        <span
                                        >Liczba sztuk do wyprodukowania: </span><span
                                            t-field="o.product_qty"
                                        /> <span t-field="o.product_uom_id.name" />
                                    </div>
                                    <div style="width: 100%">
                                        <span
                                        >Wyprodukowano: _______________</span> <span
                                            t-field="o.product_uom_id.name"
                                        />
                                    </div>
                                </div>
                                <span
                                    t-field="o.name"
                                    t-options="{'widget': 'barcode', 'width': 500, 'height': 30, 'img_style': 'width:350px;height:60px'}"
                                    class="mt-2"
                                    style="text-align: center"
                                />
                            </td>
                            <td width="50%" style="text-align: center">
                                <h2><span
                                        t-field="o.product_id.display_name"
                                        class="col-12"
                                    /></h2>
                                <h2>Project Code: <span
                                        t-field="o.analytic_account_id.name"
                                        class="col-12"
                                    /></h2>
                                <h2><span t-field="o.origin" class="col-12" /></h2>
                            </td>
                        </thead>
                        <tbody>
                            <tr>
                                <td
                                    colspan="2"
                                    style="text-align: center; padding-bottom: 10px; padding-top: 10px"
                                >
                                    <h2>Polwyroby do probania</h2>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="col-12" width="100%">
                        <thead>
                            <th width="40%">Nazwa pólwyrobu i kod</th>
                            <th width="20%">Do wydania</th>
                            <th width="20%">Wydano</th>
                            <th width="20%">Zwrot na magazyn</th>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.move_raw_ids" t-as="move">
                                <td><span t-field="move.product_id.display_name" /></td>
                                <td><span t-field="move.product_uom_qty" /> <span
                                        t-field="move.product_uom.name"
                                    /></td>
                                <td><br /><br /><br /></td>
                                <td><br /><br /><br /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div id="page2_div">
                    <table width="100%">
                        <thead>
                            <th>Operacje</th>
                            <th
                                colspan="5"
                            >Data + numer pracownika + liczba szt w jednostce czasu [np 20szt/8h]</th>
                        </thead>
                        <tbody>
                            <tr>
                                <td width="25%"><p>Labor Cutting</p><p>Cięcie</p></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                            </tr>
                            <tr>
                                <td width="25%"><p>Labor Drilling</p><p
                                    >Wiercenie</p></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                            </tr>
                            <tr>
                                <td width="25%"><p>Labor Machining</p><p
                                    >Obróbka maszynowa</p></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                            </tr>
                            <tr>
                                <td width="25%"><p>Labor Welding</p><p>Spawanie</p></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                            </tr>
                            <tr>
                                <td width="25%"><p>Labor Bending</p><p>Gięcie</p></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                            </tr>
                            <tr>
                                <td width="25%"><p>Labor Handmade Steel</p><p
                                    >Prace ręczne</p></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                                <td width="15%"><p /></td>
                            </tr>
                        </tbody>
                        <tfoot style="text-align: center">
                            <tr>
                                <td colspan="6"><b
                                    >Miejsce na pieczatki osób wykonujacych pracę</b>
                                    <br /><br /><br /><br /><br /><br /><br />
                                    <br /><br /><br /><br /><br /><br /><br />
                                </td>
                            </tr>
                            <tr>
                                <td><h3><span t-field="o.name" /></h3></td>
                                <td colspan="2">
                                    <div style="width: 100%">
                                        <span>Date of order: </span><span
                                            t-field="o.create_date"
                                            t-options="{'widget': 'date'}"
                                        />
                                    </div>
                                    <div style="width: 100%">
                                        <span>Scheduled date: </span><span
                                            t-field="o.date_planned_start"
                                            t-options="{'widget': 'date'}"
                                        />
                                    </div>
                                    <div style="width: 100%">
                                        <span>Quantity to produce: </span><span
                                            t-field="o.product_qty"
                                        /> <span t-field="o.product_uom_id.name" />
                                    </div>
                                </td>
                                <td><span t-field="o.product_id.display_name" /></td>
                                <td colspan="2"><span
                                        t-field="o.name"
                                        t-options="{'widget': 'barcode', 'width': 500, 'height': 30, 'img_style': 'width:350px;height:60px'}"
                                    /></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template
        name="Production Order Handwritten"
        id="mrp_production_handwritten_report"
    >
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="spantech_mrp.mrp_production_handwritten_report_document"
                    t-lang="o.user_id.partner_id.lang"
                />
            </t>
        </t>
    </template>

    <record id="action_report_production_order_spo" model="ir.actions.report">
        <field name="name">Production Order Handwritten (SPO)</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">spantech_mrp.mrp_production_handwritten_report</field>
        <field name="report_file">mrp.report.mrp_production_templates</field>
        <field name="print_report_name">'Production Order - %s' % object.name</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="spantech_mrp.paperformat_for_bom_structure" />
    </record>

</odoo>
