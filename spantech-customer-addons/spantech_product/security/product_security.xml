<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record model="res.groups" id="group_product_config">
        <field name="name">Product Config</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <record model="res.groups" id="group_edit_product_cost">
        <field name="name">Edit product costs</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="users" eval="[(4, ref('base.user_root'))]" />
    </record>
    <record id="ir_sequence_product_config_rule" model="ir.rule">
        <field name="name">Ir Sequence (Product Config)</field>
        <field name="model_id" ref="base.model_ir_sequence" />
        <field name="domain_force">[('product_sequence_ids', '!=', False)]</field>
        <field
            name="groups"
            eval="[(4, ref('spantech_product.group_product_config'))]"
        />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="ir_sequence_admin_rule" model="ir.rule">
        <field name="name">Ir Sequence (Admin)</field>
        <field name="model_id" ref="base.model_ir_sequence" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
