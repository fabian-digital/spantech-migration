<?xml version="1.0" ?>
<odoo>
    <record id="code_product_update_view_form" model="ir.ui.view">
        <field name="name">Code Product Update Management Form View</field>
        <field name="model">code.product.update</field>
        <field name="arch" type="xml">
            <form string="Code Product Update">
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('number_next_actual', '&lt;=', 999)]}"
                >
                    This Product sequence has reached its limit, please use another.
                </div>
                <group>
                    <field name="sequence_id" class="oe_inline" />
                    <field name="number_next_actual" invisible="1" />
                </group>
                <footer>
                    <span attrs="{'invisible': [('number_next_actual', '&gt;', 999)]}">
                    <button
                            string="Update"
                            name="action_apply_code"
                            type="object"
                            class="oe_highlight"
                        />
                    or
                    </span>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="code_product_update_action" model="ir.actions.act_window">
        <field name="name">Code Product Update</field>
        <field name="res_model">code.product.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[]</field>
    </record>
    <record
        id="code_product_update_action_view_form"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="code_product_update_view_form" />
        <field name="act_window_id" ref="code_product_update_action" />
    </record>
</odoo>
