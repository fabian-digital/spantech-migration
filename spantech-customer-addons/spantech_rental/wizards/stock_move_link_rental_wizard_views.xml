<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_move_link_rental_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.move.link.rental.wizard.view.form</field>
        <field name="model">stock.move.link.rental.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Move Rental Link">
                <sheet>
                    <group>
                        <field name="picking_id" readonly="1" force_save="1" />
                    </group>
                    <group string="Move Lines">
                        <field name="line_ids" nolabel="1">
                            <tree editable="top" create="0" delete="0">
                                <field name="sale_line_id_domain" invisible="1" />
                                <field name="stock_move_id" readonly="1" />
                                <field name="product_id" />
                                <field
                                    name="sale_line_id"
                                    domain="sale_line_id_domain"
                                />
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_link"
                        type="object"
                        string="Link"
                        class="btn btn-primary"
                    />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_move_link_rental_wizard_action" model="ir.actions.act_window">
        <field name="name">Stock Move Rental Link</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.move.link.rental.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
