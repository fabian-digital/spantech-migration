<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">spantech.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button name="download_plans" type="object" string="Download plans" />
            </header>
            <field name="order_line" position="before">
                <button
                    name="sort_by_product"
                    type="object"
                    class="oe_highlight"
                    string="Sort by Product"
                />
            </field>
            <field name="analytic_account_id" position="before">
                <field name="show_category_warning" invisible="1" />
                <field name="analytic_account_domain" invisible="1" />
            </field>
            <field name="analytic_account_id" position="attributes">
                <attribute name="domain">analytic_account_domain</attribute>
                <attribute
                    name="context"
                >{'default_partner_id':commercial_partner_id, 'default_name':name}</attribute>
            </field>
            <field name="partner_id" position="before">
                <field
                    name="commercial_partner_id"
                    widget="res_partner_many2one"
                    context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True, 'verified_partner_search_mode': 1}"
                    options='{"always_reload": True}'
                    domain="[('parent_id','=',False)]"
                />
            </field>
            <field name="partner_id" position="attributes">
                <attribute
                    name="domain"
                >['|',('id','=',commercial_partner_id),'&amp;',('parent_id','=',commercial_partner_id),('type','in',['contact','other'])]</attribute>
            </field>
            <field name="partner_invoice_id" position="attributes">
                <attribute
                    name="domain"
                >['|',('id','=',commercial_partner_id),'&amp;',('parent_id','=',commercial_partner_id),('type','in',['invoice','contact','other'])]</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute
                    name="domain"
                >['|',('id','=',commercial_partner_id),'&amp;',('parent_id','=',commercial_partner_id),('type','in',['delivery','contact','other'])]</attribute>
            </field>
            <xpath
                expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d' and not(@class='btn-primary')]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="note" position="attributes">
                <attribute name="widget">html</attribute>
            </field>
            <field name="analytic_account_id" position="after">
                <field name="project_type" />
            </field>
            <group name="sale_reporting" position="attributes">
                <attribute name="groups" />
            </group>
            <xpath
                expr="//field[@name='date_order' and @groups='base.group_no_one']"
                position="attributes"
            >
                <attribute name="groups" />
            </xpath>
            <xpath
                expr="//div[hasclass('o_td_label') and @groups='base.group_no_one']"
                position="attributes"
            >
                <attribute name="groups" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//tree/field[@name='price_unit']"
                position="after"
            >
                <field name="total_weight" sum="Total Weight" />
            </xpath>
            <sheet position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    style="margin-bottom:0px;"
                    attrs="{'invisible': [('show_category_warning', '=', False)]}"
                >
                    One of the products has the default category and then you will not be able to validate your sale order until the products have the correct settings.
                </div>
            </sheet>
            <field name="origin" position="before">
                <field name="show_commitment_date_in_document" />
            </field>
            <xpath
                expr="//t[@groups='sale.group_auto_done_setting']"
                position="attributes"
            >
                <attribute name="groups" />
            </xpath>
        </field>
    </record>
    <record id="sale_order_ratio_invoice_amount_view_order_form" model="ir.ui.view">
        <field name="name">sale_order_ratio_invoice_amount spantech inherit</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="100" />
        <field
            name="inherit_id"
            ref="sale_order_ratio_invoice_amount.view_order_form"
        />
        <field name="arch" type="xml">
            <!-- We remove amount_invoiced_ratio_total from the interface to replace it
            at the desired place on the following vue -->
            <field name="amount_invoiced_ratio_total" position="replace" />
        </field>
    </record>
    <record id="sale_order_ration_view_order_form" model="ir.ui.view">
        <field name="name">sale_order_ration_view_order_form spantech inherit</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="110" />
        <field name="inherit_id" ref="sale_order_ratio.view_order_form" />
        <field name="arch" type="xml">
            <field name="qty_invoiced_ratio_total" position="after">
                <field name="amount_invoiced_ratio_total" widget="progressbar" />
            </field>
        </field>
    </record>
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="partner_verified_date" invisible="1" />
            </field>
            <field name="name" position="after">
                <field name="client_order_ref" optional="show" />
            </field>
            <field name="partner_id" position="after">
                <field name="analytic_account_id" optional="show" />
            </field>
            <field name="partner_id" position="before">
                <field name="last_delivery_date" widget="date" optional="show" />
            </field>
        </field>
    </record>
    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="client_order_ref" optional="show" />
            </field>
            <field name="partner_id" position="after">
                <field name="analytic_account_id" optional="show" />
            </field>
            <field name="partner_id" position="before">
                <field name="last_delivery_date" widget="date" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">spantech.sale.order.list.select.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="activities_upcoming_all" position="after">
                <separator />
                <filter
                    name="partner_verified"
                    string="Partner Verified"
                    domain="[('partner_id.verified','=',True)]"
                />
                <filter
                    name="partner_not_verified"
                    string="Partner Not Verified"
                    domain="[('partner_id.verified','=',False)]"
                />
                <separator />
                <filter
                    name="verified_date"
                    string="Partner Verified Date"
                    date="partner_verified_date"
                />
                <separator />
            </filter>
            <field name="partner_id" position="after">
                <field name="analytic_account_id" />
            </field>
            <filter name="order_month" position="after">
                <filter
                    string="Analytic Account"
                    name="analytic_account_group"
                    domain="[]"
                    context="{'group_by': 'analytic_account_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
