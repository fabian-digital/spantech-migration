<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_tree" model="ir.ui.view">
        <field name="name">stock.move.tree</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">

            </field>
            <field name="reference" position="after">
                <field name="origin" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_move_tree_distrib" model="ir.ui.view">
        <field name="name">stock.move.tree.distrib</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock_analytic.view_move_tree" />
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>
</odoo>
