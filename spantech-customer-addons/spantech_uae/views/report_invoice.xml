<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document_far_east_limited"
        inherit_id="spantech_account.report_invoice_document"
        primary="True"
        priority="100"
    >
        <xpath expr="//h2" position="replace">
            <h2>
                <span
                    t-if="o.move_type == 'out_invoice' and o.state == 'posted'"
                >Tax Invoice</span>
                <span
                    t-if="o.move_type == 'out_invoice' and o.state == 'draft'"
                >Draft Tax Invoice</span>
                <span
                    t-if="o.move_type == 'out_invoice' and o.state == 'cancel'"
                >Cancelled Tax Invoice</span>
                <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                <span t-if="o.name != '/'" t-field="o.name" />
            </h2>
        </xpath>
        <xpath expr="//th[@name='th_taxes']/span" position="replace">
            <span t-if="o.company_id.country_id.code == 'AE'">VAT Rate</span>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th name="th_subtotal_currency" class="text-right">
                <span>Amount (AED)</span>
            </th>
        </xpath>
        <xpath
            expr="//span[@t-field='line.price_subtotal']/parent::td"
            position="after"
        >
            <td class="text-right o_price_total">
                <span
                    class="text-nowrap"
                    t-if="line.credit > 0"
                    t-field="line.credit"
                />
                <span class="text-nowrap" t-if="line.debit > 0" t-field="line.debit" />
            </td>
        </xpath>
        <div name="payment_term" position="after">
            <div name="conversion_rate">
                Currency Conversion Details: <span t-esc="o._get_conversion_rate()" />
            </div>
        </div>
        <t t-call="account.document_tax_totals" position="attributes">
            <attribute name="t-call">spantech_uae.document_tax_totals_uae</attribute>
        </t>
    </template>

    <template
        id="document_tax_totals_uae"
        inherit_id="account.document_tax_totals"
        primary="True"
    >
        <xpath expr="//tr[hasclass('o_subtotal')]/td[2]" position="after">
            <td
                class="text-end"
                t-if="'formatted_subtotal_amount_company_currency' in subtotal"
            >
                <span
                    t-att-class="oe_subtotal_footer_separator"
                    t-esc="subtotal['formatted_subtotal_amount_company_currency']"
                />
            </td>
        </xpath>
        <xpath expr="//tr[hasclass('o_total')]/td[2]" position="after">
            <td class="text-end">
                <t
                    t-if="o and o._get_name_invoice_report() == 'spantech_uae.report_invoice_document_far_east_limited'"
                >
                    <span t-field="o.amount_total_signed" />
                </t>
            </td>
        </xpath>
    </template>

    <template id="tax_groups_totals" inherit_id="account.tax_groups_totals">
        <xpath expr="//t[@t-as='amount_by_group']/tr" position="inside">
            <td
                class="text-end"
                t-if="'formatted_tax_group_base_amount_company_currency' in amount_by_group"
            >
                <span
                    t-esc="amount_by_group['formatted_tax_group_base_amount_company_currency']"
                />
            </td>
        </xpath>
    </template>

    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t
                t-if="o._get_name_invoice_report() == 'spantech_uae.report_invoice_document_far_east_limited'"
                t-call="spantech_uae.report_invoice_document_far_east_limited"
                t-lang="lang"
            />
        </xpath>
    </template>

    <template
        id="report_invoice_with_payments"
        inherit_id="account.report_invoice_with_payments"
    >
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t
                t-if="o._get_name_invoice_report() == 'spantech_uae.report_invoice_document_far_east_limited'"
                t-call="spantech_uae.report_invoice_document_far_east_limited"
                t-lang="lang"
            />
        </xpath>
    </template>
</odoo>
