<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']/div[@id='invoicing_settings']" position="after">
                <h2>Trilab Invoice</h2>
                <div class="row mt16 o_settings_container" id="trilab_invoice_settings">
                    <div class="col-12 col-md-6 o_setting_box" groups="account.group_account_manager">
                        <div class="o_setting_left_pane">
                            <field name="x_use_trilab_invoice"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="x_use_trilab_invoice"/>
                            <span class="fa fa-lg fa-" title="Values set here are company-specific."/>
                            <div class="text-muted">
                                Enable use of Trilab Invoice module for this company.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 o_setting_box"
                         attrs="{'invisible': [('x_use_trilab_invoice', '=', False)]}">
                        <div class="o_setting_left_pane">
                            <field name="x_enable_invoice_rate_change"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="x_enable_invoice_rate_change"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."/>
                            <div class="text-muted">
                                Change currency rate for invoices in foreign currencies according to sale date.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 o_setting_box"
                         attrs="{'invisible': [('x_use_trilab_invoice', '=', False)]}"
                         groups="account.group_account_manager">
                        <div class="o_setting_left_pane">
                            <field name="x_show_price_before_discount"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="x_show_price_before_discount"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                  groups="base.group_multi_company"/>
                            <div class="text-muted">
                                Show price before discount on Customer Invoices.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 o_setting_box"
                         attrs="{'invisible': [('x_use_trilab_invoice', '=', False)]}"
                         groups="account.group_account_manager">
                        <div class="o_setting_left_pane">
                            <field name="x_hide_zero_price_aml"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="x_hide_zero_price_aml"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                  groups="base.group_multi_company"/>
                            <div class="text-muted">
                                Hide Invoice lines on the report with zero price.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
