        <field name="paperformat_id" ref="trilab_jpk_base.paperformat_euro_landscape"/>
    </record>

    <record id="action_print_report_jpk_mag_report_xml" model="ir.actions.report">
        <field name="name">JPK MAG</field>
        <field name="model">jpk.mag.report.wizard</field>
        <field name="report_type">jpk_xml</field>
        <field name="report_name">trilab_jpk_mag.jpk_mag_report</field>
        <field name="report_file">trilab_jpk_mag.jpk_mag_report</field>
    </record>

    <record id="action_print_report_jpk_mag_report_xlsx" model="ir.actions.report">
        <field name="name">JPK MAG</field>
        <field name="model">jpk.mag.report.wizard</field>
        <field name="report_type">jpk_xlsx</field>
        <field name="report_name">trilab_jpk_mag.jpk_mag_report</field>
        <field name="report_file">trilab_jpk_mag.jpk_mag_report</field>
    </record>

    <record id="action_print_report_stock_picking_summary_report_xlsx" model="ir.actions.report">
        <field name="name">Picking Summary (XLSX)</field>
        <field name="model">stock.picking</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="report_type">jpk_xlsx</field>
        <field name="report_name">trilab_jpk_mag.stock_picking_summary_report</field>
        <field name="report_file">trilab_jpk_mag.stock_picking_summary_report</field>
