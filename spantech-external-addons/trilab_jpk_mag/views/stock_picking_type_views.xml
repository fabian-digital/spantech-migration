<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_type_form_jpk_mag" model="ir.ui.view">
        <field name="name">view.picking.type.form.jpk.mag</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <group string="JPK" name="jpk_group">
                        <field name="x_jpk_mag"/>
                    </group>
                </group>
            </xpath>
        </field>

    </record>
</odoo>
