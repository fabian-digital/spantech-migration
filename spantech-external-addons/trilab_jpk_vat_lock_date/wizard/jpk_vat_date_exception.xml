<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="jpk_vat_date_wizard" model="ir.ui.view">
        <field name="name">vat_date.exception.confirm.wizard.form</field>
        <field name="model">jpk.vat.date_exception</field>
        <field name="arch" type="xml">
            <form string="VAT Date Exception">
                <sheet>
                    <field name="message" readonly="1"/>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Yes" type="object" class="btn-secondary"/>
                    <button special="cancel" string="No" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
