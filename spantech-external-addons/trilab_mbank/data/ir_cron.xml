<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <record id="mbank_batch_status_cron" model="ir.cron">
        <field name="name">mBank Check Batch Status</field>
        <field name="model_id" ref="account_batch_payment.model_account_batch_payment"/>
        <field name="state">code</field>
        <field name="code">model.x_mbank_check_status()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>

    <record id="mbank_download_statements_cron" model="ir.cron">
        <field name="name">mBank Download Statements</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="state">code</field>
        <field name="code">model.x_mbank_download_statements()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
