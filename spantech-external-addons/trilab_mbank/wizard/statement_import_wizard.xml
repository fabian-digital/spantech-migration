<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="statement_import_wizard_form" model="ir.ui.view">
        <field name="name">statement.import.wizard.form</field>
        <field name="model">trilab_mbank.statement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import mBank Statements">
                <group>
                    <group>
                        <field name="date_from" required="1" widget="daterange"
                               options="{'related_end_date': 'date_to'}"/>
                        <field name="date_to" required="1" widget="daterange"
                               options="{'related_start_date': 'date_from'}"/>
                    </group>
                </group>
                <label for="bank_account_ids"/>
                <field name="bank_account_ids" required="1"
                       domain="[('type', '=', 'bank'), ('bank_statements_source', '=', 'mbank')]"/>
                <footer>
                    <button string="Import Statements" name="import_statements" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_statement_import_wizard" model="ir.actions.act_window">
        <field name="name">Import mBank Statements</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">trilab_mbank.statement.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="statement_import_wizard_form"/>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mbank_statement_import_wizard" name="Import mBank Statements"
              action="action_statement_import_wizard"
              parent="account.menu_finance_entries_actions" sequence="70" groups="account.group_account_manager"/>

</odoo>
