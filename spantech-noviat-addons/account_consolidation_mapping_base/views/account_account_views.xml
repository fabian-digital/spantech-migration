<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_search" model="ir.ui.view">
        <field name="name">account.search.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="consolidation_account_id"
                    groups="account_consolidation_mapping_base.group_consolidation_account_mapping"
                />
            </field>
        </field>
    </record>
    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='company_id' and @groups='base.group_multi_company']"
                position="before"
            >
                <field
                    name="consolidation_account_id"
                    groups="account_consolidation_mapping_base.group_consolidation_account_mapping"
                />
            </xpath>
        </field>
    </record>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='accounting']//field[@name='company_id']"
                position="after"
            >
                <field
                    name="consolidation_account_id"
                    groups="account_consolidation_mapping_base.group_consolidation_account_mapping"
                />
            </xpath>
        </field>
    </record>
</odoo>
