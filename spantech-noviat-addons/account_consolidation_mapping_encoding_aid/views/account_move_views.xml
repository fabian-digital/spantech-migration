<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='account_id']"
                position="before"
            >
                <field
                    name="consolidation_account_id"
                    groups="account_consolidation_mapping_base.group_consolidation_account_mapping"
                />
                <field name="consolidation_chart_id" invisible="1" />
                <field name="account_id_domain" invisible="1" />
            </xpath>
            <xpath
                expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="domain">account_id_domain</attribute>
            </xpath>
            <xpath
                expr="//page[@id='aml_tab']/field[@name='line_ids']/tree/field[@name='account_id']"
                position="before"
            >
                <field
                    name="consolidation_account_id"
                    groups="account_consolidation_mapping_base.group_consolidation_account_mapping"
                />
                <field
                    name="consolidation_account_id"
                    groups="!account_consolidation_mapping_base.group_consolidation_account_mapping"
                    invisible="1"
                />
                <field name="consolidation_chart_id" invisible="1" />
                <field name="account_id_domain" invisible="1" />
            </xpath>
            <xpath
                expr="//page[@id='aml_tab']/field[@name='line_ids']/tree/field[@name='account_id']"
                position="attributes"
            >
                <attribute name="domain">account_id_domain</attribute>
            </xpath>
        </field>
    </record>
</odoo>
