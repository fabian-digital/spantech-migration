<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="consolidation_account_search" model="ir.ui.view">
    <field name="name">consolidation.account.search.inherit</field>
    <field name="model">consolidation.account</field>
    <field name="inherit_id" ref="account_consolidation.consolidation_account_search" />
    <field name="arch" type="xml">
      <field name="name" position="attributes">
        <attribute
                    name="filter_domain"
                >['|', ('name', 'ilike', self), ('code', '=like', self + '%')]</attribute>
      </field>
    </field>
  </record>

  <record id="consolidation_account_tree" model="ir.ui.view">
    <field name="name">consolidation.account.tree.inherit</field>
    <field name="model">consolidation.account</field>
    <field name="inherit_id" ref="account_consolidation.consolidation_account_tree" />
    <field name="arch" type="xml">
      <field name="full_name" position="before">
        <field name="code" />
      </field>
    </field>
  </record>

  <record id="consolidation_account_form" model="ir.ui.view">
    <field name="name">consolidation.account.form.inherit</field>
    <field name="model">consolidation.account</field>
    <field name="inherit_id" ref="account_consolidation.consolidation_account_form" />
    <field name="arch" type="xml">
      <xpath
                expr="//field[@name='account_ids'][2]/tree/field[@name='name']"
                position="before"
            >
        <field name="code" />
      </xpath>
    </field>
  </record>

</odoo>
