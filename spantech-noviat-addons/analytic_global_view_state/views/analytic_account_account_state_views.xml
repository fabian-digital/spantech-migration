<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_analytic_account_state_view_form" model="ir.ui.view">
        <field name="name">account.analytic.account.state.view.form</field>
        <field name="model">account.analytic.account.state</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="fold" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_analytic_account_state_view_tree" model="ir.ui.view">
        <field name="name">account.analytic.account.state.view.tree</field>
        <field name="model">account.analytic.account.state</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="fold" />
            </tree>
        </field>
    </record>

    <record id="account_analytic_account_state_view_search" model="ir.ui.view">
        <field name="name">account.analytic.account.state.view.search</field>
        <field name="model">account.analytic.account.state</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="account_analytic_account_state_action" model="ir.actions.act_window">
        <field name="name">Analytic States</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.analytic.account.state</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        name="Analytic States"
        id="account_analytic_account_state_action_menu"
        parent="analytic_global_view.analytic_global_view_configuration_menu"
        action="account_analytic_account_state_action"
    />

</odoo>
