<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mail_alias_tree" model="ir.ui.view">
        <field name="name">mail.alias.tree</field>
        <field name="model">mail.alias</field>
        <field name="inherit_id" ref="mail.view_mail_alias_tree" />
        <field name="arch" type="xml">
            <field name="alias_user_id" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
    <record id="view_mail_alias_form" model="ir.ui.view">
        <field name="name">mail.alias.form</field>
        <field name="model">mail.alias</field>
        <field name="inherit_id" ref="mail.view_mail_alias_form" />
        <field name="arch" type="xml">
            <field name="alias_model_id" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
</odoo>
