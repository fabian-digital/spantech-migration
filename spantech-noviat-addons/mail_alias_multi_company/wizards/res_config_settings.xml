<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">multi-company mail settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="mail.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <div id="mail_alias_domain" position="attributes">
        <attribute name="invisible">1</attribute>
      </div>
      <div id="mail_alias_domain" position="after">
        <div class="row mt16" id="multi_company_mail_alias_domain">
          <label for="mail_alias_domain" class="col-lg-3 o_light_label" />
          <field name="mail_alias_domain" placeholder="mycompany.com" />
        </div>
      </div>
    </field>
  </record>

</odoo>
