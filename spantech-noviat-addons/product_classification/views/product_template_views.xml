<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="classification_ids" />
            </field>
        </field>
    </record>

    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.tree.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="classification_ids"
                    optional="show"
                    widget="many2many_tags"
                />
            </field>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Classifications">
                    <field
                        name="classification_ids"
                        context="{'tree_view_ref': 'product_classification.product_classification_view_tree_embedded'}"
                    />
                </page>
            </xpath>
        </field>
    </record>

</odoo>
